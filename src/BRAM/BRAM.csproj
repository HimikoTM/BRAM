<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>RobloxAccountManager</RootNamespace>
    <AssemblyName>BRAM</AssemblyName>
    <ApplicationIcon>Assets\broblox.ico</ApplicationIcon>
    <AssemblyTitle>BROBLOX Account Manager</AssemblyTitle>
    <Product>BROBLOX Account Manager</Product>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2792.45" />
    <PackageReference Include="PuppeteerSharp" Version="25.1.1" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\broblox.ico" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="WebUI\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
